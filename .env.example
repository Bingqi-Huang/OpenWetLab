# 复制为 .env 后填写。.env 不进版本库。

# 厂商 MQTT（实验室局域网）
MQTT_HOST=192.168.1.20
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASSWORD=

# 主模型（协调者使用，操作员未单独配置时共用）：格式为 提供方:模型名，如 openai:gpt-4o 或 deepseek:deepseek-reasoner
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=120

# 操作员单独模型配置（可选：三项必须同时填写，或同时留空）
OPERATOR_LLM_MODEL=
OPERATOR_LLM_BASE_URL=
OPERATOR_LLM_API_KEY=
